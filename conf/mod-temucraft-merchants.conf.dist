[worldserver]

########################################
# mod-temucraft-merchants
########################################
#
#    Temucraft.Writs.Enable
#        Description: Craftsman's Writs drop from creatures (data/sql has the writs, their daily quests and the camps of
#                     the Azeroth Commerce Authority and Durotar Supply and Logistics).
#        Default:     1

Temucraft.Writs.Enable = 1

#
#    Temucraft.Writs.DropChance
#        Description: Percent chance that a creature with loot also drops a writ of its level (from level 15).
#        Default:     3

Temucraft.Writs.DropChance = 3

#
#    Temucraft.Crates.Enable
#        Description: Waylaid Supply Crates drop from creatures; filled with gathered goods they become Sealed Crates
#                     that the supply quartermasters take for Merchant's Favor.
#        Default:     1

Temucraft.Crates.Enable = 1

#
#    Temucraft.Crates.DropChance
#        Description: Percent chance that a creature with loot also drops a crate of its level (from level 5).
#        Default:     2

Temucraft.Crates.DropChance = 2

#
#    Temucraft.Writs.TierCreatureLevels
#        Description: Lowest creature level that drops writs of each of the 5 tiers.
#        Default:     "15 30 45 60 70"

Temucraft.Writs.TierCreatureLevels = "15 30 45 60 70"

#
#    Temucraft.Writs.ItemFirst
#        Description: First writ item id. Must match data/sql.
#        Default:     601710

Temucraft.Writs.ItemFirst = 601710

#
#    Temucraft.Writs.ItemLast
#        Description: Last writ item id. Must match data/sql.
#        Default:     601969

Temucraft.Writs.ItemLast = 601969

#
#    Temucraft.Writs.CampCreatureFirst
#        Description: First merchant camp creature (put on the ground at startup). Must match data/sql.
#        Default:     601971

Temucraft.Writs.CampCreatureFirst = 601971

#
#    Temucraft.Writs.CampCreatureLast
#        Description: Last merchant camp creature. Must match data/sql.
#        Default:     601974

Temucraft.Writs.CampCreatureLast = 601974

#
#    Temucraft.Crates.TierCreatureLevels
#        Description: Lowest creature level that drops crates of each of the 6 tiers (Apprentice to Grand Master).
#        Default:     "5 15 30 45 60 70"

Temucraft.Crates.TierCreatureLevels = "5 15 30 45 60 70"
